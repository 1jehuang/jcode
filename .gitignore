/target
Cargo.lock
__pycache__/
ios_simulator_screenshot.png
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, ios/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Agent skills vendored by 'npx skills add' - local tooling, not repo content.
/.agents/
/.claude/skills/
/skills-lock.json

# Swarm/agent artifact output written into the repo root by relative paths.
# These are scratch reports, not source: keeping them untracked stops them from
# marking every self-dev build dirty.
/artifacts/