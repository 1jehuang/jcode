# Normalise text files in the repository and convert on checkout.
#
# Without this, line-ending behaviour depends on each contributor's global
# core.autocrlf, so the same file is CRLF for one person and LF for the next.
# Edits made by tooling that writes LF then land inside a CRLF working tree,
# and every subsequent commit warns "LF will be replaced by CRLF".
#
# `text=auto` keeps binary files untouched and lets git detect them, so this is
# safe to apply repository-wide.
* text=auto

# Shell scripts are executed, not just read. With `text=auto` alone a Windows
# checkout gets CRLF, and every `bash scripts/install.sh` then fails with
# "No such file or directory" because the shebang becomes `/usr/bin/env bash\r`.
# Pinning them to LF keeps the installers and their test scripts runnable on
# every platform.
*.sh text eol=lf
*.bash text eol=lf

# Markdown is read by tests that parse fenced examples with literal `\n`
# separators, so it must not carry CRLF either.
*.md text eol=lf
docs/**/*.md text eol=lf
