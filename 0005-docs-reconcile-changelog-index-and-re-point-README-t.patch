+        RATE_WINDOW_START_MILLIS.store(0, Ordering::SeqCst);
+        RATE_WINDOW_ACTIONS.store(0, Ordering::SeqCst);
+        for _ in 0..MAX_SYNTHESIZED_ACTIONS_PER_MINUTE {
